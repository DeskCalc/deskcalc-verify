{
  "name": "@deskcalc/verify",
  "version": "1.0.0",
  "description": "MCP server: let a human check and confirm numbers in DeskCalc before an AI agent uses the total.",
  "mcpName": "com.deskcalc/verify",
  "type": "module",
  "bin": {
    "deskcalc-verify": "dist/server.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist/server.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.js --banner:js=\"#!/usr/bin/env node\" --legal-comments=none",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mcpb": "npm run build && node scripts/pack-mcpb.mjs",
    "plugin": "npm run build && node scripts/pack-plugin.mjs"
  },
  "keywords": [
    "mcp",
    "deskcalc",
    "adding-machine",
    "verification",
    "human-in-the-loop"
  ],
  "author": "DeskCalc GbR",
  "license": "MIT",
  "homepage": "https://www.deskcalc.com/",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
